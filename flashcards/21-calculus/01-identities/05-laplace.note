!id: QTvuUZHeoc
!text: \[ \mathscr{L} \{ {{c2::1::\ldots}} \} = {{c1::\frac{1}{s}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ 1 \} &= \frac{1}{s} \\
\mathscr{L} \{ t^n \} &= \frac{n!}{s^{n+1}}
\end{align*}
\]
~~~

!id: iXsVLLDXns
!text: \[ \mathscr{L} \{ {{c2::t^n::\ldots}} \}, \, {{c2::n = 1, 2, 3, \ldots::\ldots}} = {{c1::\frac{n!}{ s^{n + 1} }::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ 1 \} &= \frac{1}{s} \\
\mathscr{L} \{ t^n \} &= \frac{n!}{s^{n+1}}
\end{align*}
\]
~~~

!id: PvgQ6jEvcc
!text: \[ \mathscr{L} \{ {{c2::\sin(at)::\ldots}} \} = {{c1::\frac{a}{s^2 + a^2}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at) \} &= \frac{a}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at) \} &= \frac{s}{s^2 + a^2} \\
\mathscr{L} \{ \sinh(at) \} &= \frac{a}{s^2 - a^2} \\
\mathscr{L} \{ \cosh(at) \} &= \frac{s}{s^2 - a^2}
\end{align*}
\]
~~~

!id: KxBr2RjOR9
!text: \[ \mathscr{L} \{ {{c2::\cos(at)::\ldots}} \} = {{c1::\frac{s}{s^2 + a^2}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at) \} &= \frac{a}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at) \} &= \frac{s}{s^2 + a^2} \\
\mathscr{L} \{ \sinh(at) \} &= \frac{a}{s^2 - a^2} \\
\mathscr{L} \{ \cosh(at) \} &= \frac{s}{s^2 - a^2}
\end{align*}
\]
~~~

!id: JbxidpgYmY
!text: \[ \mathscr{L} \{ {{c2::\sin(at + b)::\ldots}} \} = {{c1::\frac{s \sin(b) + a \cos(b)}{s^2 + a^2}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at + b) \} &= \frac{s \sin(b) + a \cos(b)}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at + b) \} &= \frac{s \cos(b) - a \sin(b)}{s^2 + a^2}
\end{align*}
\]
~~~

!id: 0m5XTDb891
!text: \[ \mathscr{L} \{ {{c2::\cos(at + b)::\ldots}} \} = {{c1::\frac{s \cos(b) - a \sin(b)}{s^2 + a^2}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ \sin(at + b) \} &= \frac{s \sin(b) + a \cos(b)}{s^2 + a^2} \\
\mathscr{L} \{ \cos(at + b) \} &= \frac{s \cos(b) - a \sin(b)}{s^2 + a^2}
\end{align*}
\]
~~~

!id: pA5dGLSWi3
!text: \[ \mathscr{L} \{ {{c2::t \sin(at)::\ldots}} \} = {{c1::\frac{2as}{(s^2 + a^2)^2}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ t \sin(at) \} &= \frac{2as}{(s^2 + a^2)^2} \\
\mathscr{L} \{ t \cos(at) \} &= \frac{s^2 - a^2}{(s^2 + a^2)^2}
\end{align*}
\]
~~~

