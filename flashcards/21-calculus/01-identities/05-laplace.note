!id: 5Yyk0c34WV
!text: \[ \mathscr{L} \{ {{c2::e^{ct} f(t)::\ldots}} \} = {{c1::F(s - c)::\ldots}} \]
!back extra: First shifting property.
~~~

!id: fdOn6cVnzl
!text: \[ \mathscr{L} \{ {{c2::e^{ct}::\ldots}} \} = {{c1::\frac{1}{s - c}::\ldots}} \]
!back extra: First shifting property.
!related: \[ \mathscr{L} \{ e^{ct} f(t) \} = F(s - c) \]
~~~

!id: w1LANadzEm
!text: \[ \mathscr{L} \{ {{c2::e^{ct} t^n::\ldots}} \}, \, {{c2::n = 1, 2, 3, \ldots::\ldots}} = {{c1::\frac{n!}{ (s - c)^{n + 1} }::\ldots}} \]
!back extra: First shifting property.
!related: \[ \mathscr{L} \{ e^{ct} f(t) \} = F(s - c) \]
~~~

!id: 7o3R4MwOB9
!text: \[ \mathscr{L} \{ {{c2::e^{ct} \sin(at)::\ldots}} \} = {{c1::\frac{a}{(s - c)^2 + a^2}::\ldots}} \]
!back extra: First shifting property.
!related:
\[
\newcommand{\eqrow}{\vphantom{\frac{s-c}{(s-c)^2-a^2}}}
\begin{align*}
\eqrow\mathscr{L}\{e^{ct}f(t)\} &= F(s-c) \\
\eqrow\mathscr{L}\{e^{ct}\sin(at)\} &= \frac{a}{(s-c)^2+a^2} \\
\eqrow\mathscr{L}\{e^{ct}\cos(at)\} &= \frac{s-c}{(s-c)^2+a^2} \\
\eqrow\mathscr{L}\{e^{ct}\sinh(at)\} &= \frac{a}{(s-c)^2-a^2} \\
\eqrow\mathscr{L}\{e^{ct}\cosh(at)\} &= \frac{s-c}{(s-c)^2-a^2}
\end{align*}
\]
~~~

!id: xbx26KkwSa
!text: \[ \mathscr{L} \{ {{c2::e^{ct} \cos(at)::\ldots}} \} = {{c1::\frac{s - c}{(s - c)^2 + a^2}::\ldots}} \]
!back extra: First shifting property.
!related:
\[
\newcommand{\eqrow}{\vphantom{\frac{s-c}{(s-c)^2-a^2}}}
\begin{align*}
\eqrow\mathscr{L}\{e^{ct}f(t)\} &= F(s-c) \\
\eqrow\mathscr{L}\{e^{ct}\sin(at)\} &= \frac{a}{(s-c)^2+a^2} \\
\eqrow\mathscr{L}\{e^{ct}\cos(at)\} &= \frac{s-c}{(s-c)^2+a^2} \\
\eqrow\mathscr{L}\{e^{ct}\sinh(at)\} &= \frac{a}{(s-c)^2-a^2} \\
\eqrow\mathscr{L}\{e^{ct}\cosh(at)\} &= \frac{s-c}{(s-c)^2-a^2}
\end{align*}
\]
~~~

