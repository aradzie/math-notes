!id: eWZVpXHZHT
!text: \[ \mathscr{L} \{ {{c2::\delta (t - c)::\ldots}} \} = {{c1::e^{-cs}::\ldots}}, \quad c \ge 0 \]
!back extra: Second shifting property.
!related:
\[
\begin{align*}
\mathscr{L} \{ \delta (t - c) \} &= e^{-cs} \\
\mathscr{L} \{ u(t - c) \} &= e^{-cs} \frac{1}{s}
\end{align*}
\]
~~~

!id: zPCcs1lXNy
!text: \[ \mathscr{L} \{ {{c2::u(t - c)::\ldots}} \} = {{c1::e^{-cs} \frac{1}{s}::\ldots}}, \quad c \ge 0 \]
!back extra: Second shifting property.
!related:
\[
\begin{align*}
\mathscr{L} \{ \delta (t - c) \} &= e^{-cs} \\
\mathscr{L} \{ u(t - c) \} &= e^{-cs} \frac{1}{s}
\end{align*}
\]
~~~

!id: adMtfr9qBK
!text: \[ \mathscr{L} \{ {{c2::u(t - c) f(t - c)::\ldots}} \} = {{c1::e^{-cs} F(s)::\ldots}}, \quad c \ge 0 \]
!back extra: Second shifting property.
!related:
\[
\begin{align*}
\mathscr{L} \{ u(t - c) f(t - c) \} &= e^{-cs} F(s) \\
\mathscr{L} \{ u(t - c) f(t) \} &= e^{-cs} \mathscr{L} \{ f(t + c) \}
\end{align*}
\]
~~~

!id: kIbJOsABVa
!text: \[ \mathscr{L} \{ {{c2::u(t - c) f(t)::\ldots}} \} = {{c1::e^{-cs} \mathscr{L} \{ f(t + c) \}::\ldots}}, \quad c \ge 0 \]
!back extra: Second shifting property.
!related:
\[
\begin{align*}
\mathscr{L} \{ u(t - c) f(t - c) \} &= e^{-cs} F(s) \\
\mathscr{L} \{ u(t - c) f(t) \} &= e^{-cs} \mathscr{L} \{ f(t + c) \}
\end{align*}
\]
~~~

!id: B21mgFJd11
!text: \[ \mathscr{L} \left\{ {{c2::\frac{f(t)}{t}::\ldots}} \right\} = {{c1::\int_{s}^{\infty} F(u) \, du::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \left\{ \frac{f(t)}{t} \right\} &= \int_{s}^{\infty} F(u) \, du \\
\frac{F(s)}{s} &= \mathscr{L} \left\{ \int_{0}^{t} f(u) \, du \right\}
\end{align*}
\]
~~~

!id: UFaxrl14aM
!text: \[ \mathscr{L} \left\{ {{c2::\int_{0}^{t} f(u) \, du::\ldots}} \right\} = {{c1::\frac{F(s)}{s}::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \left\{ \frac{f(t)}{t} \right\} &= \int_{s}^{\infty} F(u) \, du \\
\frac{F(s)}{s} &= \mathscr{L} \left\{ \int_{0}^{t} f(u) \, du \right\}
\end{align*}
\]
~~~

!id: J3EhdjUjZz
!text: \[ \mathscr{L} \{ {{c2::f'(t)::\ldots}} \} = {{c1::s F(s) - f(0)::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ f'(t) \} &= s F(s) - f(0) \\
\mathscr{L} \{ f''(t) \} &= s^2 F(s) - s f(0) - f'(0)
\end{align*}
\]
~~~

!id: P2i1umjr8F
!text: \[ \mathscr{L} \{ {{c2::f''(t)::\ldots}} \} = {{c1::s^2 F(s) - s f(0) - f'(0)::\ldots}} \]
!related:
\[
\begin{align*}
\mathscr{L} \{ f'(t) \} &= s F(s) - f(0) \\
\mathscr{L} \{ f''(t) \} &= s^2 F(s) - s f(0) - f'(0)
\end{align*}
\]
~~~
