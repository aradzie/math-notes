\begin{align*}
\mathscr{L} \{ t \sin(at) \} &= \frac{2as}{(s^2 + a^2)^2} \\
\mathscr{L} \{ t \cos(at) \} &= \frac{s^2 - a^2}{(s^2 + a^2)^2}
\end{align*}
\]
~~~

