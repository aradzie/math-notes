!deck: Math Identities
!tags: Math Calculus Identity Derivative
!type: Cloze Math

!id: t5nrJzqDxs
!text:
\[
\frac{d}{dx} ( {{c2::f(x) g(x)::\ldots}} )
=
{{c1::f'(x) g(x) + f(x) g'(x)::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} ( f(x) g(x) ) &= f'(x) g(x) + f(x) g'(x) \\[12pt]
\frac{d}{dx} \frac{f(x)}{g(x)} &= \frac{f'(x) g(x) - f(x) g'(x)}{(g(x))^2} \\[10pt]
\frac{d}{dx} \frac{1}{f(x)} &= -\frac{f'(x)}{(f(x))^2}
\end{align*}
\]
~~~

!id: 4LkQydoQNz
!text:
\[
\frac{d}{dx} {{c2::\frac{f(x)}{g(x)}::\ldots}}
=
{{c1::\frac{f'(x) g(x) - f(x) g'(x)}{(g(x))^2}::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} ( f(x) g(x) ) &= f'(x) g(x) + f(x) g'(x) \\[12pt]
\frac{d}{dx} \frac{f(x)}{g(x)} &= \frac{f'(x) g(x) - f(x) g'(x)}{(g(x))^2} \\[10pt]
\frac{d}{dx} \frac{1}{f(x)} &= -\frac{f'(x)}{(f(x))^2}
\end{align*}
\]
~~~

