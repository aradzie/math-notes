!text:
\[
\frac{d}{dx} {{c2::\csc x::\ldots}}
=
{{c1::-\csc x \cot x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec x &= \sec x \tan x \\
\frac{d}{dx} \csc x &= -\csc x \cot x \\
\frac{d}{dx} \operatorname{sech} x &= -\operatorname{sech} x \tanh x \\
\frac{d}{dx} \operatorname{csch} x &= -\operatorname{csch} x \coth x
\end{align*}
\]
~~~

!id: 7zeaG6d155
!text:
\[
\frac{d}{dx} {{c2::\sin^{-1} x::\ldots}}
=
{{c1::\frac{1}{ \sqrt{1 - x^2} }::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin^{-1} x &= \frac{1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \cos^{-1} x &= \frac{-1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \sinh^{-1} x &= \frac{1}{\sqrt{x^2 + 1}} \\
\frac{d}{dx} \cosh^{-1} x &= \frac{1}{\sqrt{x^2 - 1}}
\end{align*}
\]
~~~

!id: K8dEzzGKlO
!text:
\[
\frac{d}{dx} {{c2::\cos^{-1} x::\ldots}}
=
{{c1::\frac{-1}{ \sqrt{1 - x^2} }::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin^{-1} x &= \frac{1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \cos^{-1} x &= \frac{-1}{\sqrt{1 - x^2}} \\
\frac{d}{dx} \sinh^{-1} x &= \frac{1}{\sqrt{x^2 + 1}} \\
\frac{d}{dx} \cosh^{-1} x &= \frac{1}{\sqrt{x^2 - 1}}
\end{align*}
\]
~~~

!id: wiOugx4jUm
!text:
\[
\frac{d}{dx} {{c2::\tan^{-1} x::\ldots}}
=
{{c1::\frac{1}{1 + x^2}::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan^{-1} x &= \frac{1}{1 + x^2} \\
\frac{d}{dx} \cot^{-1} x &= \frac{-1}{1 + x^2} \\
\frac{d}{dx} \tanh^{-1} x &= \frac{1}{1 - x^2}, \quad |x| < 1 \\
\frac{d}{dx} \coth^{-1} x &= \frac{1}{1 - x^2}, \quad |x| > 1
\end{align*}
\]
~~~

!id: RNhVRNAfSu
!text:
\[
\frac{d}{dx} {{c2::\cot^{-1} x::\ldots}}
=
{{c1::\frac{-1}{1 + x^2}::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan^{-1} x &= \frac{1}{1 + x^2} \\
\frac{d}{dx} \cot^{-1} x &= \frac{-1}{1 + x^2} \\
\frac{d}{dx} \tanh^{-1} x &= \frac{1}{1 - x^2}, \quad |x| < 1 \\
\frac{d}{dx} \coth^{-1} x &= \frac{1}{1 - x^2}, \quad |x| > 1
\end{align*}
\]
~~~

!id: HqNvqfc8sK
!text:
\[
\frac{d}{dx} {{c2::\sec^{-1} x::\ldots}}
=
{{c1::\frac{1}{ |x| \sqrt{x^2 - 1} }::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec^{-1} x &= \frac{1}{|x| \sqrt{x^2 - 1}} \\
\frac{d}{dx} \csc^{-1} x &= \frac{-1}{|x| \sqrt{x^2 - 1}} \\
\frac{d}{dx} \operatorname{sech}^{-1} x &= \frac{-1}{x \sqrt{1 - x^2}} \\
\frac{d}{dx} \operatorname{csch}^{-1} x &= \frac{-1}{|x| \sqrt{1 + x^2}}
\end{align*}
\]
~~~

!id: pgYkMoL28Q
!text:
\[
\frac{d}{dx} {{c2::\csc^{-1} x::\ldots}}
=
{{c1::\frac{-1}{ |x| \sqrt{x^2 - 1} }::\ldots}}
