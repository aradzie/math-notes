!id: VXuQLADXL9
!text:
\[
\frac{d}{dx} {{c2::e^x::\ldots}}
=
{{c1::e^x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} e^x &= e^x \\
\frac{d}{dx} a^x &= a^x \ln a
\end{align*}
\]
~~~

!id: Rr5fOXUw9O
!text:
\[
\frac{d}{dx} {{c2::a^x::\ldots}}
=
{{c1::a^x \ln a::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} e^x &= e^x \\
\frac{d}{dx} a^x &= a^x \ln a
\end{align*}
\]
~~~

!id: qa7HhtQgYV
!text:
\[
\frac{d}{dx} {{c2::\ln x::\ldots}}
=
{{c1::\frac{1}{x}::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \ln x &= \frac{1}{x} \\
\frac{d}{dx} \log_b x &= \frac{1}{x \ln b}
\end{align*}
\]
~~~

!id: ePdj1D19Kq
!text:
\[
\frac{d}{dx} {{c2::\log_b x::\ldots}}
=
{{c1::\frac{1}{x \ln b}::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \ln x &= \frac{1}{x} \\
\frac{d}{dx} \log_b x &= \frac{1}{x \ln b}
\end{align*}
\]
~~~

!tags: Math Calculus Derivative Trigonometric Identity

!id: FZ7A022KJ2
!text:
\[
\frac{d}{dx} {{c2::\sin x::\ldots}}
=
{{c1::\cos x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin x &= \cos x \\
\frac{d}{dx} \cos x &= -\sin x \\
\frac{d}{dx} \sinh x &= \cosh x \\
\frac{d}{dx} \cosh x &= \sinh x
\end{align*}
\]
~~~

!id: Tgs9LnpPni
!text:
\[
\frac{d}{dx} {{c2::\cos x::\ldots}}
=
{{c1::-\sin x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sin x &= \cos x \\
\frac{d}{dx} \cos x &= -\sin x \\
\frac{d}{dx} \sinh x &= \cosh x \\
\frac{d}{dx} \cosh x &= \sinh x
\end{align*}
\]
~~~

!id: TpTuy8lSRy
!text:
\[
\frac{d}{dx} {{c2::\tan x::\ldots}}
=
{{c1::\sec^2 x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan x &= \sec^2 x \\
\frac{d}{dx} \cot x &= -\csc^2 x \\
\frac{d}{dx} \tanh x &= \operatorname{sech}^2 x \\
\frac{d}{dx} \coth x &= -\operatorname{csch}^2 x
\end{align*}
\]
~~~

!id: nfMUAAp0SF
!text:
\[
\frac{d}{dx} {{c2::\cot x::\ldots}}
=
{{c1::-\csc^2 x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \tan x &= \sec^2 x \\
\frac{d}{dx} \cot x &= -\csc^2 x \\
\frac{d}{dx} \tanh x &= \operatorname{sech}^2 x \\
\frac{d}{dx} \coth x &= -\operatorname{csch}^2 x
\end{align*}
\]
~~~

!id: IaeOyR20YC
!text:
\[
\frac{d}{dx} {{c2::\sec x::\ldots}}
=
{{c1::\sec x \tan x::\ldots}}
\]
!related:
\[
\begin{align*}
\frac{d}{dx} \sec x &= \sec x \tan x \\
\frac{d}{dx} \csc x &= -\csc x \cot x \\
\frac{d}{dx} \operatorname{sech} x &= -\operatorname{sech} x \tanh x \\
\frac{d}{dx} \operatorname{csch} x &= -\operatorname{csch} x \coth x
\end{align*}
\]
~~~

