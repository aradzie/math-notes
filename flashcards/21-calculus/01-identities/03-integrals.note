!deck: Math Identities
!tags: Math Calculus Identity Integral
!type: Cloze Math

!id: wkZfScoStf
!text: \[ \int {{c2::u^n::\ldots}} \, du = {{c1::\frac{ u^{n + 1} }{n + 1}::\ldots}} + C, \quad n \neq -1 \]
~~~

!id: O5dWcJ9Ayb
!text: \[ \int {{c2::\frac{1}{u}::\ldots}} \, du = {{c1::\ln |u|::\ldots}} + C \]
~~~

!id: OjNsbOEVDV
!text: \[ \int {{c2::e^u::\ldots}} \, du = {{c1::e^u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int e^u \, du &= e^u + C \\
\int a^u \, du &= \frac{a^u}{\ln a} + C
\end{align*}
\]
~~~

!id: C3z9AssfLB
!text: \[ \int {{c2::a^u::\ldots}} \, du = {{c1::\frac{a^u}{\ln a}::\ldots}} + C \]
!related:
\[
\begin{align*}
\int e^u \, du &= e^u + C \\
\int a^u \, du &= \frac{a^u}{\ln a} + C
\end{align*}
\]
~~~

!tags: Math Calculus Identity Integral Trigonometry

!id: zAVj6GfoZR
!text: \[ \int {{c2::\sin u::\ldots}} \, du = {{c1::-\cos u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sin u \, du &= -\cos u + C \\
\int \cos u \, du &= \sin u + C \\
\int \sinh u \, du &= \cosh u + C \\
\int \cosh u \, du &= \sinh u + C
\end{align*}
\]
~~~

!id: oK1hDvqKcd
!text: \[ \int {{c2::\cos u::\ldots}} \, du = {{c1::\sin u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sin u \, du &= -\cos u + C \\
\int \cos u \, du &= \sin u + C \\
\int \sinh u \, du &= \cosh u + C \\
\int \cosh u \, du &= \sinh u + C
\end{align*}
\]
~~~

!id: I9VYBduCcQ
!text: \[ \int {{c2::\sec^2 u::\ldots}} \, du = {{c1::\tan u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sec^2 u \, du &= \tan u + C \\
\int \csc^2 u \, du &= -\cot u + C \\
\int \operatorname{sech}^2 u \, du &= \tanh u + C \\
\int \operatorname{csch}^2 u \, du &= -\coth u + C
\end{align*}
\]
~~~

!id: EDFBfS4M5y
!text: \[ \int {{c2::\csc^2 u::\ldots}} \, du = {{c1::-\cot u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sec^2 u \, du &= \tan u + C \\
\int \csc^2 u \, du &= -\cot u + C \\
\int \operatorname{sech}^2 u \, du &= \tanh u + C \\
\int \operatorname{csch}^2 u \, du &= -\coth u + C
\end{align*}
\]
~~~

!id: xb4WwEeP4r
!text: \[ \int {{c2::\sec u \tan u::\ldots}} \, du = {{c1::\sec u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sec u \tan u \, du &= \sec u + C \\
\int \csc u \cot u \, du &= -\csc u + C \\
\int \operatorname{sech} u \tanh u \, du &= -\operatorname{sech} u + C \\
\int \operatorname{csch} u \coth u \, du &= -\operatorname{csch} u + C
\end{align*}
\]
~~~

!id: MpqIMluMrf
!text: \[ \int {{c2::\csc u \cot u::\ldots}} \, du = {{c1::-\csc u::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sec u \tan u \, du &= \sec u + C \\
\int \csc u \cot u \, du &= -\csc u + C \\
\int \operatorname{sech} u \tanh u \, du &= -\operatorname{sech} u + C \\
\int \operatorname{csch} u \coth u \, du &= -\operatorname{csch} u + C
\end{align*}
\]
~~~

!id: wS35O29y1B
!text: \[ \int {{c3::\tan u::\ldots}} \, du = {{c1::-\ln | \cos u |::\ldots}} + C = {{c2::\ln | \sec u |::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \tan u \, du &= -\ln | \cos u | + C = \ln | \sec u | + C \\
\int \cot u \, du &= \ln | \sin u | + C = -\ln | \csc u | + C
\end{align*}
\]
~~~

!id: Tyr7GCU37U
!text: \[ \int {{c3::\cot u::\ldots}} \, du = {{c1::\ln | \sin u |::\ldots}} + C = {{c2::-\ln | \csc u |::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \tan u \, du &= -\ln | \cos u | + C = \ln | \sec u | + C \\
\int \cot u \, du &= \ln | \sin u | + C = -\ln | \csc u | + C
\end{align*}
\]
~~~

!id: DocsvOi7wA
!text: \[ \int {{c2::\sec u::\ldots}} \, du = {{c1::\ln | \sec u + \tan u |::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sec u \, du &= \ln | \sec u + \tan u | + C \\
\int \csc u \, du &= \ln | \csc u - \cot u | + C
\end{align*}
\]
~~~

!id: aHE3dRfXPV
!text: \[ \int {{c2::\csc u::\ldots}} \, du = {{c1::\ln | \csc u -\cot u |::\ldots}} + C \]
!related:
\[
\begin{align*}
\int \sec u \, du &= \ln | \sec u + \tan u | + C \\
\int \csc u \, du &= \ln | \csc u - \cot u | + C
\end{align*}
\]
~~~

!id: IBMbxRjYIT
!text: \[ \int {{c2::\frac{1}{ \sqrt{a^2 - u^2} }::\ldots}} \, du = {{c1::\sin^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ |u| < a \]
!related:
\[
\begin{align*}
\int \frac{1}{\sqrt{a^2-u^2}} \, du &= \sin^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{-1}{\sqrt{a^2-u^2}} \, du &= \cos^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{\sqrt{u^2+a^2}} \, du &= \sinh^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{\sqrt{u^2-a^2}} \, du &= \cosh^{-1}\frac{u}{a} + C, && a>0,\ u>a
\end{align*}
\]
~~~

!id: SabCElSD01
!text: \[ \int {{c2::\frac{-1}{ \sqrt{a^2 - u^2} }::\ldots}} \, du = {{c1::\cos^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ |u| < a \]
!related:
\[
\begin{align*}
\int \frac{1}{\sqrt{a^2-u^2}} \, du &= \sin^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{-1}{\sqrt{a^2-u^2}} \, du &= \cos^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{\sqrt{u^2+a^2}} \, du &= \sinh^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{\sqrt{u^2-a^2}} \, du &= \cosh^{-1}\frac{u}{a} + C, && a>0,\ u>a
\end{align*}
\]
~~~

!id: h01ddvdFDL
!text: \[ \int {{c2::\frac{1}{a^2 + u^2}::\ldots}} \, du = {{c1::\frac{1}{a} \tan^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0 \]
!related:
\[
\begin{align*}
\int \frac{1}{a^2+u^2} \, du &= \frac{1}{a}\tan^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{-1}{a^2+u^2} \, du &= \frac{1}{a}\cot^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\tanh^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\coth^{-1}\frac{u}{a} + C, && a>0,\ |u|>a
\end{align*}
\]
~~~

!id: FCRvy1wkbV
!text: \[ \int {{c2::\frac{-1}{a^2 + u^2}::\ldots}} \, du = {{c1::\frac{1}{a} \cot^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0 \]
!related:
\[
\begin{align*}
\int \frac{1}{a^2+u^2} \, du &= \frac{1}{a}\tan^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{-1}{a^2+u^2} \, du &= \frac{1}{a}\cot^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\tanh^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\coth^{-1}\frac{u}{a} + C, && a>0,\ |u|>a
\end{align*}
\]
~~~

!id: 9qP24hPifN
!text: \[ \int {{c2::\frac{1}{ |u| \sqrt{u^2 - a^2} }::\ldots}} \, du = {{c1::\frac{1}{a} \sec^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ |u| > a \]
!related:
\[
\begin{align*}
\int \frac{1}{|u|\sqrt{u^2-a^2}} \, du &= \frac{1}{a}\sec^{-1}\frac{u}{a} + C, && a>0,\ |u|>a \\
\int \frac{-1}{|u|\sqrt{u^2-a^2}} \, du &= \frac{1}{a}\csc^{-1}\frac{u}{a} + C, && a>0,\ |u|>a \\
\int \frac{-1}{u\sqrt{a^2-u^2}} \, du &= \frac{1}{a}\operatorname{sech}^{-1}\frac{u}{a} + C, && a>0,\ 0<u<a \\
\int \frac{-1}{|u|\sqrt{a^2+u^2}} \, du &= \frac{1}{a}\operatorname{csch}^{-1}\frac{u}{a} + C, && a>0,\ u\ne0
\end{align*}
\]
~~~

!id: 2nlG4eU8bT
!text: \[ \int {{c2::\frac{-1}{ |u| \sqrt{u^2 - a^2} }::\ldots}} \, du = {{c1::\frac{1}{a} \csc^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ |u| > a \]
!related:
\[
\begin{align*}
\int \frac{1}{|u|\sqrt{u^2-a^2}} \, du &= \frac{1}{a}\sec^{-1}\frac{u}{a} + C, && a>0,\ |u|>a \\
\int \frac{-1}{|u|\sqrt{u^2-a^2}} \, du &= \frac{1}{a}\csc^{-1}\frac{u}{a} + C, && a>0,\ |u|>a \\
\int \frac{-1}{u\sqrt{a^2-u^2}} \, du &= \frac{1}{a}\operatorname{sech}^{-1}\frac{u}{a} + C, && a>0,\ 0<u<a \\
\int \frac{-1}{|u|\sqrt{a^2+u^2}} \, du &= \frac{1}{a}\operatorname{csch}^{-1}\frac{u}{a} + C, && a>0,\ u\ne0
\end{align*}
\]
~~~

