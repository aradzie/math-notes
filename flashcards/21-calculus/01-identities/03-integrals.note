!id: ztPjAdSTUK
!text: \[ \int {{c2::\frac{1}{ \sqrt{u^2 + a^2} }::\ldots}} \, du = {{c1::\sinh^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0 \]
!related:
\[
\begin{align*}
\int \frac{1}{\sqrt{a^2-u^2}} \, du &= \sin^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{-1}{\sqrt{a^2-u^2}} \, du &= \cos^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{\sqrt{u^2+a^2}} \, du &= \sinh^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{\sqrt{u^2-a^2}} \, du &= \cosh^{-1}\frac{u}{a} + C, && a>0,\ u>a
\end{align*}
\]
~~~

!id: Tcye6b55BF
!text: \[ \int {{c2::\frac{1}{ \sqrt{u^2 - a^2} }::\ldots}} \, du = {{c1::\cosh^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ u > a \]
!related:
\[
\begin{align*}
\int \frac{1}{\sqrt{a^2-u^2}} \, du &= \sin^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{-1}{\sqrt{a^2-u^2}} \, du &= \cos^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{\sqrt{u^2+a^2}} \, du &= \sinh^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{\sqrt{u^2-a^2}} \, du &= \cosh^{-1}\frac{u}{a} + C, && a>0,\ u>a
\end{align*}
\]
~~~

!id: WtH1PZoJ5V
!text: \[ \int {{c2::\frac{1}{a^2 - u^2}::\ldots}} \, du = {{c1::\frac{1}{a} \tanh^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ |u| < a \]
!related:
\[
\begin{align*}
\int \frac{1}{a^2+u^2} \, du &= \frac{1}{a}\tan^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{-1}{a^2+u^2} \, du &= \frac{1}{a}\cot^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\tanh^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\coth^{-1}\frac{u}{a} + C, && a>0,\ |u|>a
\end{align*}
\]
~~~

!id: 3qQ4G2JKdw
!text: \[ \int {{c2::\frac{1}{a^2 - u^2}::\ldots}} \, du = {{c1::\frac{1}{a} \coth^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ |u| > a \]
!related:
\[
\begin{align*}
\int \frac{1}{a^2+u^2} \, du &= \frac{1}{a}\tan^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{-1}{a^2+u^2} \, du &= \frac{1}{a}\cot^{-1}\frac{u}{a} + C, && a>0 \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\tanh^{-1}\frac{u}{a} + C, && a>0,\ |u|<a \\
\int \frac{1}{a^2-u^2} \, du &= \frac{1}{a}\coth^{-1}\frac{u}{a} + C, && a>0,\ |u|>a
\end{align*}
\]
~~~

!id: 8dVcpCwsiY
!text: \[ \int {{c2::\frac{-1}{ u\sqrt{a^2 - u^2} }::\ldots}} \, du = {{c1::\frac{1}{a} \operatorname{sech}^{-1} \frac{u}{a}::\ldots}} + C, \quad a > 0,\ 0 < u < a \]
!related:
\[
\begin{align*}
\int \frac{1}{|u|\sqrt{u^2-a^2}} \, du &= \frac{1}{a}\sec^{-1}\frac{u}{a} + C, && a>0,\ |u|>a \\
