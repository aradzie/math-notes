!deck: Math Identities
!tags: Math Trigonometric Identity
!type: Cloze Math

!id: 1Md8vTm3q0
!text:
\[
{{c2::\sin^2 \theta +\cos^2 \theta::\sin, \cos}}
=
{{c1::1::\ldots}}
\]

Pythagorean Identity
!related:
\[
\begin{align*}
\sin^2 \theta +\cos^2 \theta &= 1 \\
\sec^2 \theta -\tan^2 \theta &= 1 \\
\csc^2 \theta -\cot^2 \theta &= 1
\end{align*}
\]
~~~

!id: HsMBeMRwdm
!text:
\[
{{c2::\sec^2 \theta -\tan^2 \theta::\sec, \tan}}
=
{{c1::1::\ldots}}
\]

Pythagorean Identity
!related:
\[
\begin{align*}
\sin^2 \theta +\cos^2 \theta &= 1 \\
\sec^2 \theta -\tan^2 \theta &= 1 \\
\csc^2 \theta -\cot^2 \theta &= 1
\end{align*}
\]
~~~

