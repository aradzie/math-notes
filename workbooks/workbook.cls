%% Shared layout and problem numbering for standalone workbooks.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{workbook}[2026/10/19 Workbook document class]

\DeclareOption*{\PassOptionsToClass{\CurrentOption}{article}}
\ProcessOptions\relax
\LoadClass[11pt]{article}

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\RequirePackage[a4paper,margin=1in]{geometry}

\setlength{\parskip}{5pt}
\setlength{\parindent}{0pt}

\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}
\gdef\@subtitle{}

\newcommand{\aigennotice}{%
  \begin{center}
    \small\itshape
    This document was generated by a large language model (LLM) and may contain errors.
  \end{center}
  \vspace{6pt}
}

\renewcommand{\maketitle}{%
  \begin{center}
    {\Huge\bfseries\@title\par}\vspace{12pt}
    \ifx\@subtitle\@empty\else
      {\large\@subtitle\par}\vspace{14pt}
    \fi
    \ifx\@author\@empty\else
      {\normalsize\@author\par}\vspace{8pt}
    \fi
    \ifx\@date\@empty\else
      {\normalsize\@date\par}\vspace{8pt}
    \fi
  \end{center}
  \vspace{6pt}
  \aigennotice
}

\newcounter{problem}
\newenvironment{problem}[1]
  {\refstepcounter{problem}\par\medskip\noindent\textbf{\theproblem. #1}\quad}
  {\par}

\RequirePackage{hyperref}
\hypersetup{
  hidelinks,
  pdfstartview=Fit,
}
