{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(echo *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(file *)",
      "Bash(make)",
      "Bash(make *)",
      "Bash(podman --version)",
      "Bash(podman run *)",
      "Bash(podman pull *)",
      "Bash(toolbox run *)",
      "Bash(./texlive.sh *)",
      "Bash(../texlive.sh *)",
      "Bash(npx notatki *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pdftoppm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/skill-reminder.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
